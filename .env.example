# Copy to .env. Local mode requires only Node.js 24+; do not use this key in production.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
JWT_SECRET=local-development-only-change-this-secret-2026
SQLITE_PATH=.runtime/freshmarket.sqlite
# Set DATABASE_URL to switch to PostgreSQL. Redis and RabbitMQ are optional locally.
# DATABASE_URL=postgres://freshmarket:password@localhost:5432/freshmarket
# REDIS_URL=redis://localhost:6379
# AMQP_URL=amqp://freshmarket:password@localhost:5672
CORS_ORIGIN=http://localhost:5173
ORDER_TTL_MINUTES=15
SEED_DEMO=true
